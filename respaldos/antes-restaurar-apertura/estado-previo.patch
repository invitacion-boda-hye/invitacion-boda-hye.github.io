+.envelope-screen.revealing-hero.fading-envelope {
+  background: transparent;
+}
+
+.envelope-screen.revealing-hero.fading-envelope::before,
+.envelope-screen.revealing-hero.fading-envelope::after,
+.envelope-screen.revealing-hero.fading-envelope .welcome-floral,
+.envelope-screen.revealing-hero.fading-envelope .envelope-container {
+  opacity: 0;
+  transition: opacity .6s ease-in-out;
+}
+
+@media (prefers-reduced-motion: reduce) {
