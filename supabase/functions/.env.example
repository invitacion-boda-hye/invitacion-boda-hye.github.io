# Archivo de referencia: no agregues valores reales al repositorio.
# Para desarrollo local, cópialo como supabase/functions/.env y complétalo.
# En producción, Supabase inyecta SUPABASE_URL y las claves de API; configura
# solamente ALLOWED_ORIGINS y PUBLIC_INVITATION_URL como secretos propios.

SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEYS={"default":"sb_publishable_REEMPLAZAR"}
SUPABASE_SECRET_KEYS={"default":"sb_secret_REEMPLAZAR_NUNCA_EN_EL_NAVEGADOR"}
ALLOWED_ORIGINS=https://tu-dominio.example,https://www.tu-dominio.example
PUBLIC_INVITATION_URL=https://tu-dominio.example
